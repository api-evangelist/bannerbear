{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bannerbear Animated GIFs Auth API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Verify the API key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bannerbear.com/v2/auth"
          },
          "docs": "Verify the API key"
        },
        {
          "info": {
            "name": "Retrieve account status, quota, and usage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bannerbear.com/v2/account"
          },
          "docs": "Retrieve account status, quota, and usage"
        }
      ]
    }
  ],
  "bundled": true
}