{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bannerbear Animated GIFs Collections API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Collections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List collections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bannerbear.com/v2/collections",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for paginated lists (25 per page)."
              }
            ]
          },
          "docs": "List collections"
        },
        {
          "info": {
            "name": "Create a collection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bannerbear.com/v2/collections",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generates multiple images from a template set by applying a single set of modifications across every template in the set."
        },
        {
          "info": {
            "name": "Retrieve a collection",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bannerbear.com/v2/collections/:uid",
            "params": [
              {
                "name": "uid",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the resource."
              }
            ]
          },
          "docs": "Retrieve a collection"
        }
      ]
    }
  ],
  "bundled": true
}